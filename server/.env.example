# Administrator account email. Create a user with this email to access /admin.
ADMIN_EMAIL=admin@example.com

# Optional dedicated administrator password. Set this to allow admin sign-in
# without first creating the administrator as a regular user.
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Long random signing key for login tokens. Never commit the real value.
JWT_SECRET=replace-with-a-long-random-secret

# PostgreSQL connection string used by `npm run db:push`.
# Example: postgresql://user:password@host:5432/database?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/tradeforge

# Server settings.
PORT=5000
NODE_ENV=development
# Origin of a separately hosted frontend, for example https://app.example.com.
# Leave empty when the frontend is served by this backend.
CLIENT_ORIGIN=

# MongoDB persistence. Use the URI from MongoDB Atlas or your local server.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=tradeforge

# SMTP settings used to deliver numeric email verification codes.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
# Set to true only after valid SMTP credentials are configured.
SMTP_ENABLED=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=your-email@gmail.com
# Set to true when email verification is ready.
EMAIL_VERIFICATION_ENABLED=false

# Optional Replit-only setting. Leave empty for local development.
# REPL_ID=
